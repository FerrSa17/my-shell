prefer-no-csd
input {

    //KEYBOARD-SETTING
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"

        }

        numlock
    }

    //TOUCHPAD-SETTING
    touchpad {
        tap
        natural-scroll
    }

    //MOUSE-SETTING
    mouse {
        
    }
}

//OUTPUT
output "HDMI-A-1" {
    mode "1920x1080@120.030"
    scale 1
    position x=1280 y=0

    hot-corners {
        off
    }
}

layout {

    //ALL_INDENT
    gaps 12
    center-focused-column "never"
    default-column-width { proportion 0.90; }

    // PRESET-WIDTH
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // FOCUS-BORDER
    focus-ring {
        off
    }

    // BORDER
    border {
        on

        width 3
        active-gradient from="#d65d0e" to="#d79921" angle=45
        inactive-color "#282828"

        urgent-color "#9b0000"
    }

    // WINDOW SHADOW
    shadow {
        off
    }

    // REGULAR WINDOW INDENT
    struts {
        // left ?px
        // right ?px
        // top ?px
        // bottom ?px
    }
}

// AUTOSTART
spawn-at-startup "awww-daemon"
spawn-at-startup "waybar"
spawn-at-startup "swaync"

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 18
}

//HOTKEYS
hotkey-overlay {
    skip-at-startup

}


//ANIMATIONS
animations {
    // Общее ускорение всех анимаций (1.0 = обычная скорость)
    slowdown 0.85

    // Переключение между окнами / рабочими столами
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    // Открытие окна — плавное появление без резкости
    window-open {
        duration-ms 180
        curve "cubic-bezier" 0.05 0.7 0.1 1
    }

    // Закрытие окна — чуть быстрее открытия
    window-close {
        duration-ms 140
        curve "ease-out-quad"
    }

    // Горизонтальное перемещение по колонкам
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    // Перемещение окна (перетаскивание/свап)
    window-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    // Изменение размера окна
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // Уведомления о изменении конфига
    config-notification-open-close {
        spring damping-ratio=0.8 stiffness=1000 epsilon=0.001
    }

    // Диалог подтверждения выхода
    exit-confirmation-open-close {
        spring damping-ratio=0.8 stiffness=600 epsilon=0.01
    }

    // Открытие интерфейса скриншота
    screenshot-ui-open {
        duration-ms 150
        curve "ease-out-quad"
    }

    // Overview (общий вид всех окон)
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

//WINDOW-RULE
window-rule {
    clip-to-geometry true
}

window-rule {
  match title="Firefox"
  open-maximized true
}


screenshot-path "~/Pictures/Screenshots/Screenshot %d.%m.%Y %H:%M.png"

//KEY-BINDS
binds {

    // Custom binds
    Mod+Return                { spawn "foot"; }
    Mod+Shift+Return          { spawn "firefox"; }
    Mod+N 		      { spawn-sh "swaync-client -t"; }
    Mod+Space                 { spawn-sh "$HOME/scripts/rofi/program-menu/program-menu.sh"; }
    Mod+Escape                { spawn-sh "$HOME/scripts/rofi/power-menu/power-menu.sh"; }
    Mod+C                     { spawn-sh "python $HOME/scripts/wallpaper.py"; }
    Mod+Shift+S               { screenshot; }

    Mod+Shift+F               { switch-preset-column-width; }
    Mod+R                     { reset-window-height; }


    // System binds
    XF86AudioRaiseVolume      { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume      { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }

    Mod+O repeat=false        { toggle-overview; }

    Mod+Q repeat=false        { close-window; }

    Mod+Left                  { focus-column-left; }
    Mod+Down                  { focus-window-down; }
    Mod+Up                    { focus-window-up; }
    Mod+Right                 { focus-column-right; }
    Mod+H                     { focus-column-left; }
    Mod+L                     { focus-column-right; }

    Mod+Shift+Left            { move-column-left; }
    Mod+Shift+Down            { move-window-down; }
    Mod+Shift+Up              { move-window-up; }
    Mod+Shift+Right           { move-column-right; }
    Mod+Shift+H               { move-column-left; }
    Mod+Shift+L               { move-column-right; }

    Mod+Ctrl+Shift+Left       { consume-or-expel-window-left; }
    Mod+Ctrl+Shift+Right      { consume-or-expel-window-right; }

    Mod+J                     { focus-window-or-workspace-down; }
    Mod+K                     { focus-window-or-workspace-up; }
    Mod+Shift+J                { move-window-down-or-to-workspace-down; }
    Mod+Shift+K                { move-window-up-or-to-workspace-up; }

    Mod+Page_Down             { focus-workspace-down; }
    Mod+Page_Up               { focus-workspace-up; }
    Mod+U                     { focus-workspace-down; }
    Mod+I                     { focus-workspace-up; }
    Mod+Ctrl+Page_Down        { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up          { move-column-to-workspace-up; }
    Mod+Ctrl+U                { move-column-to-workspace-down; }
    Mod+Ctrl+I                { move-column-to-workspace-up; }

    Mod+Shift+Page_Down       { move-workspace-down; }
    Mod+Shift+Page_Up         { move-workspace-up; }
    Mod+Shift+U               { move-workspace-down; }
    Mod+Shift+I               { move-workspace-up; }

    Mod+WheelScrollDown       { focus-workspace-down; }
    Mod+WheelScrollUp         { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown  { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp    { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Shift+WheelScrollRight { move-column-right; }
    Mod+Shift+WheelScrollLeft  { move-column-left; }

    Mod+1                     { focus-workspace 1; }
    Mod+2                     { focus-workspace 2; }
    Mod+3                     { focus-workspace 3; }
    Mod+4                     { focus-workspace 4; }
    Mod+5                     { focus-workspace 5; }
    Mod+6                     { focus-workspace 6; }
    Mod+7                     { focus-workspace 7; }
    Mod+8                     { focus-workspace 8; }
    Mod+9                     { focus-workspace 9; }
    Mod+Shift+1               { move-column-to-workspace 1; }
    Mod+Shift+2               { move-column-to-workspace 2; }
    Mod+Shift+3               { move-column-to-workspace 3; }
    Mod+Shift+4               { move-column-to-workspace 4; }
    Mod+Shift+5               { move-column-to-workspace 5; }
    Mod+Shift+6               { move-column-to-workspace 6; }
    Mod+Shift+7               { move-column-to-workspace 7; }
    Mod+Shift+8               { move-column-to-workspace 8; }
    Mod+Shift+9               { move-column-to-workspace 9; }

    Mod+F                     { maximize-column; }
    Mod+F11                   { fullscreen-window; }

    Mod+M                     { maximize-window-to-edges; }
    
    Mod+V                     { toggle-window-floating; }
    Mod+Shift+V               { switch-focus-between-floating-and-tiling; }

}
